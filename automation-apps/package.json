{
  "name": "hydra-qa-automation-apps",
  "version": "1.0.0",
  "description": "HydraQA Mobile Automation — Appium + WebdriverIO + Cucumber BDD",
  "scripts": {
    "test:android": "TEST_PLATFORM=android wdio run wdio.conf.ts",
    "test:ios": "TEST_PLATFORM=ios wdio run wdio.conf.ts",
    "test:android:tag": "TEST_PLATFORM=android wdio run wdio.conf.ts --cucumberOpts.tags",
    "test:ios:tag": "TEST_PLATFORM=ios wdio run wdio.conf.ts --cucumberOpts.tags",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write 'src/**/*.ts'"
  },
  "dependencies": {
    "@wdio/cli": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/cucumber-framework": "^9.0.0",
    "@wdio/allure-reporter": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "appium": "^2.15.0",
    "appium-uiautomator2-driver": "^3.0.0",
    "appium-xcuitest-driver": "^7.0.0",
    "dotenv": "^16.4.7",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "ts-node": "^10.9.2",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0"
  }
}

