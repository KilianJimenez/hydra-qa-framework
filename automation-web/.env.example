# ──────────────────────────────────────
# HydraQA Web Automation — Environment
# ──────────────────────────────────────

# Target environment: local | staging | production
TEST_ENV=local

# Browser: chromium | firefox | webkit
BROWSER=chromium

# Set to "true" to run in headed mode
HEADED=false

# Log level: error | warn | info | debug
LOG_LEVEL=info

