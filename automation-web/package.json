{
  "name": "hydra-qa-automation-web",
  "version": "1.0.0",
  "description": "HydraQA Web Automation — Playwright + Cucumber BDD",
  "scripts": {
    "test": "cucumber-js --config cucumber.js",
    "test:headed": "HEADED=true cucumber-js --config cucumber.js",
    "test:debug": "PWDEBUG=1 cucumber-js --config cucumber.js",
    "test:tag": "cucumber-js --config cucumber.js --tags",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write 'src/**/*.ts'"
  },
  "dependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@playwright/test": "^1.50.0",
    "playwright": "^1.50.0",
    "dotenv": "^16.4.7",
    "winston": "^3.17.0",
    "allure-cucumberjs": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "ts-node": "^10.9.2",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0"
  }
}

